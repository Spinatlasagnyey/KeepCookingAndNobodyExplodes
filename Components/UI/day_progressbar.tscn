[sub_resource type="GDScript" id="GDScript_r50qu"]
script/source = "extends TextureProgressBar

func _ready() -> void:
	EventManager.poison_value_changed.connect(change_value)

func change_value(new_value: float) -> void:
	value = new_value
"

[sub_resource type="GDScript" id="GDScript_wikva"]
script/source = "extends TextureProgressBar

func _process(delta: float) -> void:
	
	if EventManager.time_passed < EventManager.SECONDS_PER_DAY/2:
		value = EventManager.time_passed
	else:
		value = EventManager.SECONDS_PER_DAY - EventManager.time_passed
"

